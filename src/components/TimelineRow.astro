---
interface Props {
  name: string;
  years: string;
  detail: string;
  href?: string;
  logo: string;
  logoAlt: string;
  showSpine?: boolean;
}

const { name, years, detail, href, logo, logoAlt, showSpine = true } = Astro.props;
---

<div class="flex gap-2">
  <div class="flex shrink-0 flex-col items-center">
    <img
      src={logo}
      alt={logoAlt}
      class="h-6 w-6 shrink-0"
      loading="eager"
      width="24"
      height="24"
      decoding="async"
    />
    {
      showSpine && (
        <span class="select-none font-mono leading-tight text-black/40" aria-hidden="true">
          |
        </span>
      )
    }
  </div>
  {
    href ? (
      <a class="grid w-full md:flex md:justify-between" href={href} target="_blank" rel="noopener noreferrer">
        <p class="whitespace-nowrap font-mono hover:cursor-pointer hover:underline">
          <span class="font-bold">{name}</span>{' '}
          <span class="text-black/40">({years})</span>
        </p>
        <p class="font-mono">{detail}</p>
      </a>
    ) : (
      <div class="grid w-full md:flex md:justify-between">
        <p class="whitespace-nowrap font-mono">
          <span class="font-bold">{name}</span>{' '}
          <span class="text-black/40">({years})</span>
        </p>
        <p class="font-mono">{detail}</p>
      </div>
    )
  }
</div>
