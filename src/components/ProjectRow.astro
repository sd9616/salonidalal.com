---
interface Props {
  name: string;
  blurb: string;
  href?: string;
}

const { name, blurb, href } = Astro.props;
---

{
  href ? (
    <a class="grid md:flex md:justify-between" href={href} target="_blank" rel="noopener noreferrer">
      <div class="flex space-x-2">
        <p class="whitespace-nowrap font-mono font-bold hover:cursor-pointer hover:underline">
          {name}
        </p>
      </div>
      <p class="font-mono">{blurb}</p>
    </a>
  ) : (
    <div class="grid md:flex md:justify-between">
      <div class="flex space-x-2">
        <p class="whitespace-nowrap font-mono font-bold">{name}</p>
      </div>
      <p class="font-mono">{blurb}</p>
    </div>
  )
}
