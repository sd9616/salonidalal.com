---
interface Props {
  name: string;
  blurb: string;
  href?: string;
}

const { name, blurb, href } = Astro.props;
---

<div
  class="grid gap-y-0.5 md:grid-cols-[minmax(0,14rem)_1fr] md:items-baseline md:gap-x-4"
>
  <div class="min-w-0">
    {
      href ? (
        <a
          href={href}
          target="_blank"
          rel="noopener noreferrer"
          class="font-bold hover:underline"
          data-astro-prefetch
        >
          {name}
        </a>
      ) : (
        <span class="font-bold">{name}</span>
      )
    }
  </div>
  <p class="text-left md:text-right">{blurb}</p>
</div>
