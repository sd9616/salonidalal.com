---
interface Props {
  name: string;
  years: string;
  detail: string;
  href?: string;
  logo: string;
  logoAlt: string;
  showSpine?: boolean;
}

const { name, years, detail, href, logo, logoAlt, showSpine = true } = Astro.props;
---

<div class="grid grid-cols-[1.5rem_1fr] gap-x-2">
  <div class="flex flex-col items-center">
    <img
      src={logo}
      alt={logoAlt}
      width="24"
      height="24"
      class="size-6 shrink-0 object-contain"
      loading="lazy"
    />
    {
      showSpine && (
        <span
          class="mt-0.5 select-none text-[rgb(0_0_0_/_0.4)] leading-none"
          aria-hidden="true"
        >
          |
        </span>
      )
    }
  </div>
  <div
    class="grid gap-y-0.5 md:grid-cols-[1fr_auto] md:items-baseline md:justify-between md:gap-x-4"
  >
    <div class="min-w-0">
      {
        href ? (
          <a
            href={href}
            target="_blank"
            rel="noopener noreferrer"
            class="font-bold hover:underline"
            data-astro-prefetch
          >
            {name}
          </a>
        ) : (
          <span class="font-bold">{name}</span>
        )
      }
      <span class="ml-2 text-[rgb(0_0_0_/_0.4)]">{years}</span>
    </div>
    <p class="text-left md:text-right">{detail}</p>
  </div>
</div>
