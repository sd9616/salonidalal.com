---
interface Props {
  name: string;
  years: string;
  detail: string;
  href?: string;
  logo: string;
  logoAlt: string;
  logoClass?: string;
  showSpine?: boolean;
}

const { name, years, detail, href, logo, logoAlt, logoClass = '', showSpine = true } =
  Astro.props;
---

<div class="flex gap-2">
  <div class="flex flex-col items-center shrink-0">
    <div class="flex h-6 w-6 shrink-0 items-center justify-center overflow-hidden">
      <img
        src={logo}
        alt={logoAlt}
        class:list={['h-6', 'w-6', 'shrink-0', logoClass]}
        loading="eager"
        width="24"
        height="24"
        decoding="async"
      />
    </div>
    {
      showSpine && (
        <span class="font-mono text-black/40 select-none leading-tight" aria-hidden="true">
          |
        </span>
      )
    }
  </div>
  {
    href ? (
      <a
        class="grid md:flex md:justify-between w-full"
        href={href}
        target="_blank"
        rel="noopener noreferrer"
      >
        <p class="font-mono whitespace-nowrap hover:underline hover:cursor-pointer">
          <span class="font-bold">{name}</span>{' '}
          <span class="text-black/40">({years})</span>
        </p>
        <p class="font-mono">{detail}</p>
      </a>
    ) : (
      <div class="grid md:flex md:justify-between w-full">
        <p class="font-mono whitespace-nowrap">
          <span class="font-bold">{name}</span>{' '}
          <span class="text-black/40">({years})</span>
        </p>
        <p class="font-mono">{detail}</p>
      </div>
    )
  }
</div>
