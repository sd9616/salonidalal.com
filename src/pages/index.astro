---
import Layout from '../layouts/Layout.astro';
import TimelineRow from '../components/TimelineRow.astro';
import ProjectRow from '../components/ProjectRow.astro';
import {
  site,
  experience,
  education,
  projects,
  links,
  emailParts,
} from '../data/site';

const emailOnClick = `event.preventDefault();window.location.href='mai'+'lto:'+'${emailParts.user}'+'@'+'${emailParts.domain}'`;
---

<Layout>
  <div class="m-auto flex h-screen max-w-4xl p-8" transition:animate="fade">
    <div class="my-auto w-full">
      <div class="flex space-x-12 font-mono">
        <p class="font-mono text-2xl font-bold">{site.name}</p>
      </div>

      <div>
        <p class="font-mono">{site.role}</p>
        <p class="mt-1 font-mono text-sm text-black/60">{site.support}</p>
      </div>

      <div class="mt-4">
        <p class="font-mono text-lg font-bold">Experience</p>
        <div class="mt-2">
          {
            experience.map((item, i) => (
              <TimelineRow
                name={item.org}
                years={item.years}
                detail={item.scope}
                href={item.href}
                logo={item.logo}
                logoAlt={item.logoAlt}
                showSpine={i < experience.length - 1}
              />
            ))
          }
        </div>
      </div>

      <div class="mt-4">
        <p class="font-mono text-lg font-bold">Education</p>
        <div class="mt-2">
          {
            education.map((item, i) => (
              <TimelineRow
                name={item.school}
                years={item.years}
                detail={item.line}
                href={item.href}
                logo={item.logo}
                logoAlt={item.logoAlt}
                showSpine={i < education.length - 1}
              />
            ))
          }
        </div>
      </div>

      <div class="mt-4">
        <p class="font-mono text-lg font-bold">Projects</p>
        <div class="mt-2 space-y-1">
          {
            projects.map((item) => (
              <ProjectRow name={item.name} blurb={item.blurb} href={item.href} />
            ))
          }
        </div>
      </div>

      <div class="mt-4 font-mono text-sm text-black/50">
        <p class="select-none">---</p>
        <div class="mt-2 flex flex-wrap gap-x-2">
          {
            links.map((link, i) => (
              <>
                {link.kind === 'email' ? (
                  <a
                    href="#"
                    class="transition-colors hover:text-black"
                    data-email
                    onclick={emailOnClick}
                  >
                    [{link.label}]
                  </a>
                ) : (
                  <a
                    href={link.href}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="transition-colors hover:text-black"
                  >
                    [{link.label}]
                  </a>
                )}
                {i < links.length - 1 && <span class="select-none">/</span>}
              </>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</Layout>
